# Configuration for QPGen — Question Paper Generator
# Copy this file to .env and fill in your values.

# Your Google AI Studio API key (required)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key

# Gemini model for question generation
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for text embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
