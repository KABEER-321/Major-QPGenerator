# Configuration for QPGen — Question Paper Generator
# Copy this file to .env and fill in your values.

# Your Google AI Studio API key (required)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key

# Gemini model for question generation
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for text embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Administrator initial credentials (optional, recommended for setup)
# If ADMIN_PASSWORD is left blank, a secure random password is generated on startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@qpgen.local
ADMIN_PASSWORD=SetAStrongPasswordHere2026!
